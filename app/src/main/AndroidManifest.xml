<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FR-12：语音命令「会了」——仅 CommandWindow 内识别，绝无后台监听（Phase 5 Step 1） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- E2（2026-09-14）：SpeechRecognizer.isRecognitionAvailable 内部 queryIntentServices 受
         Android 11+ 包可见性过滤——无本声明时系统识别服务对 App 不可见，探测可能失真。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- FR-25（SCR-BGPLAYBACK）：熄屏/后台续播前台媒体服务（mediaPlayback 类型 + WakeLock + 通知栏控制） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VocabularyBoosterApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VocabularyBooster">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FR-25（SCR-BGPLAYBACK）：熄屏/后台续播前台媒体服务（PlaybackForegroundController 驱动启停） -->
        <service
            android:name=".playback.PlaybackForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

</manifest>
