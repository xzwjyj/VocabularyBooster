-- WordBookEntryDefinition（DATABASE_SCHEMA §2.6，schema v2）：收藏时的释义选择（FR-5）
-- v2 起不含 includeExamples：例句选择粒度细化到逐 Example（WordBookEntryExampleSelection）
CREATE TABLE WordBookEntryDefinition (
  wordBookEntryDefinitionId  INTEGER PRIMARY KEY AUTOINCREMENT,
  wordBookEntryId            INTEGER NOT NULL REFERENCES WordBookEntry(wordBookEntryId) ON DELETE CASCADE,
  definitionEntryId          INTEGER NOT NULL REFERENCES DefinitionEntry(definitionEntryId)
);
CREATE UNIQUE INDEX WordBookEntryDefinition_unique
  ON WordBookEntryDefinition(wordBookEntryId, definitionEntryId);

insertEntryDefinition:
INSERT INTO WordBookEntryDefinition(wordBookEntryId, definitionEntryId)
VALUES (?, ?);

selectEntryDefinitions:
SELECT * FROM WordBookEntryDefinition WHERE wordBookEntryId = ?;

-- Q7 词条选择编辑（FR-17，Phase 8.5）：定向替换释义选择（与 WordBookEntryExampleSelection.sq 的
-- deleteExampleSelectionsForEntry 配对，均在 updateWordSelections 单事务内）。
-- query-only——无 DDL/索引/FK 变更，schema 维持 v2，无迁移
deleteEntryDefinitionsForEntry:
DELETE FROM WordBookEntryDefinition WHERE wordBookEntryId = ?;
