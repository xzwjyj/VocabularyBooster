-- Example（DATABASE_SCHEMA §2.3）：例句原子单元（句子+译文+音频+来源+合规，FR-3 / NFR-5）
CREATE TABLE Example (
  exampleId          INTEGER PRIMARY KEY AUTOINCREMENT,
  definitionEntryId  INTEGER NOT NULL REFERENCES DefinitionEntry(definitionEntryId) ON DELETE CASCADE,
  sentence           TEXT NOT NULL,
  chineseTranslation TEXT NOT NULL,
  sourceType         TEXT NOT NULL,      -- REAL_MOVIE_TV|CELEBRITY_SPEECH|TED|AUDIOBOOK|LICENSED_OTHER|TTS|TATOEBA
  sourceRef          TEXT,
  licenseNote        TEXT,                -- 合规留存（NFR-5）
  audioUri           TEXT,                -- 原声；空则 TTS 朗读 sentence
  audioDurationMs    INTEGER,
  exampleOrder       INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX Example_byEntry ON Example(definitionEntryId, exampleOrder);

insertExample:
INSERT INTO Example(definitionEntryId, sentence, chineseTranslation, sourceType, sourceRef, licenseNote, audioUri, audioDurationMs, exampleOrder)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectExamplesForEntry:
SELECT * FROM Example WHERE definitionEntryId = ? ORDER BY exampleOrder ASC;

-- 例句回填（Phase 8.6 Tatoeba 译文补齐）：只补译文，不动其它列
updateExampleTranslation:
UPDATE Example SET chineseTranslation = ? WHERE exampleId = ?;

selectLastInsertRowId:
SELECT last_insert_rowid();

-- SCR-SENSEATTR 例句重归位：移动归属释义（exampleId 不变——用户勾选行经 exampleId 关联，天然保留；
-- exampleOrder 一并指派，避免目标释义内与既有行 order 碰撞导致播放顺序不稳定）
moveExampleToEntry:
UPDATE Example SET definitionEntryId = ?, exampleOrder = ? WHERE exampleId = ?;

-- 删除守卫：例句是否被词条例句勾选行引用（有引用绝不删，宁留不错删；FR-5 选择粒度）
countExampleSelections:
SELECT COUNT(*) FROM WordBookEntryExampleSelection WHERE exampleId = ?;

-- 按主键删（仅词典重归位路径用于剔除词典已移除的 TATOEBA/AI_GENERATED 例句；先经 countExampleSelections 守卫）
deleteExampleById:
DELETE FROM Example WHERE exampleId = ?;
