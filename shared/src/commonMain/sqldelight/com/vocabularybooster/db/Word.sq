-- Word（DATABASE_SCHEMA §2.1）：全局词条母数据，normalizedText 唯一（FR-1 大小写不敏感查词 + FR-14 导入复用）
CREATE TABLE Word (
  wordId                 INTEGER PRIMARY KEY AUTOINCREMENT,
  text                   TEXT NOT NULL,
  normalizedText         TEXT NOT NULL,
  ipaAm                  TEXT,
  ipaBr                  TEXT,
  pronunciationAudioUri  TEXT,          -- 授权发音音频（预留，v1 用 TTS）
  createdAt              INTEGER NOT NULL,
  updatedAt              INTEGER NOT NULL
);
CREATE UNIQUE INDEX Word_normalizedText ON Word(normalizedText);

insertWord:
INSERT INTO Word(text, normalizedText, ipaAm, ipaBr, pronunciationAudioUri, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectByNormalizedText:
SELECT * FROM Word WHERE normalizedText = ?;

selectById:
SELECT * FROM Word WHERE wordId = ?;

countAll:
SELECT COUNT(*) FROM Word;

-- 前缀搜索（Phase 2 查词 UI；repo 负责归一化与拼 %）
searchWords:
SELECT * FROM Word WHERE normalizedText LIKE ? ORDER BY length(normalizedText) ASC, normalizedText ASC LIMIT ?;

-- 增强回填（Phase 8.6）：补空缺美音音标；调用方守卫 ipaAm IS NULL 才调（绝不覆盖已有值）
updateWordIpa:
UPDATE Word SET ipaAm = ?, updatedAt = ? WHERE wordId = ?;

selectLastInsertRowId:
SELECT last_insert_rowid();
