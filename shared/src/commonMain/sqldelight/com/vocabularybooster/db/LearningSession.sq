-- LearningSession（DATABASE_SCHEMA §2.8）：学习会话（FR-6/FR-11 崩溃恢复）
CREATE TABLE LearningSession (
  sessionId   INTEGER PRIMARY KEY AUTOINCREMENT,
  wordBookId  INTEGER NOT NULL REFERENCES WordBook(wordBookId) ON DELETE RESTRICT, -- 先 ABANDONED 再删本
  status      TEXT NOT NULL,      -- ACTIVE|COMPLETED|ABANDONED
  groupSize   INTEGER NOT NULL,   -- 会话固化值
  startedAt   INTEGER NOT NULL,
  endedAt     INTEGER
);

insertSession:
INSERT INTO LearningSession(wordBookId, status, groupSize, startedAt, endedAt) VALUES (?, ?, ?, ?, ?);

selectSessionById:
SELECT * FROM LearningSession WHERE sessionId = ?;

updateSessionStatus:
UPDATE LearningSession SET status = ?, endedAt = ? WHERE sessionId = ?;

-- ACTIVE 会话查询（FR-11 崩溃恢复入口 + LE spec §3 唯一性事务内检查）；
-- 全局最多一个 ACTIVE 为引擎不变量，不设 DB 级约束（DATABASE_SCHEMA §2.8 注记），
-- LIMIT 1 + DESC 仅保证（规格外的）脏数据下读取仍确定
selectActiveSession:
SELECT * FROM LearningSession WHERE status = 'ACTIVE' ORDER BY sessionId DESC LIMIT 1;

selectLastInsertRowId:
SELECT last_insert_rowid();

-- Q9 学习统计·会话时长流（FR-20，Phase 8.6）：已结束会话（endedAt 非空；崩溃未恢复的
-- ACTIVE 行不计时长——口径见 PROJECT_SPEC FR-20）；时长 = endedAt - startedAt，
-- 按结束日归集（Kotlin 分桶，注入 TimeZone）。
-- query-only——无 DDL/索引/FK 变更，schema 维持 v2，无迁移
selectEndedSessions:
SELECT startedAt, endedAt FROM LearningSession WHERE endedAt IS NOT NULL;
