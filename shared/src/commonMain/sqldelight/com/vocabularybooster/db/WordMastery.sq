-- WordMastery（DATABASE_SCHEMA §2.7）：行存在 = MASTERED，作用域（WordBook, Word）（D4）；幂等（FR-7）
CREATE TABLE WordMastery (
  wordBookId  INTEGER NOT NULL REFERENCES WordBook(wordBookId) ON DELETE CASCADE,
  wordId      INTEGER NOT NULL REFERENCES Word(wordId),
  masteredAt  INTEGER NOT NULL,
  PRIMARY KEY (wordBookId, wordId)
);

-- 事务规则（DATABASE_SCHEMA §4）：与 SessionWord→MASTERED 同一事务；重复插入静默忽略
markMastered:
INSERT OR IGNORE INTO WordMastery(wordBookId, wordId, masteredAt) VALUES (?, ?, ?);

isMastered:
SELECT * FROM WordMastery WHERE wordBookId = ? AND wordId = ?;

countMastered:
SELECT COUNT(*) FROM WordMastery WHERE wordBookId = ?;

-- 从生词本移除词时清掉本内掌握行（避免悬挂的 (bookId, wordId) 记录；FR-4 移除语义）
deleteMasteryForWordInBook:
DELETE FROM WordMastery WHERE wordBookId = ? AND wordId = ?;
